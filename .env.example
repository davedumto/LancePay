# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Neon Database
# DATABASE_URL: Neon *pooled* connection string (host contains "-pooler"). Used for
# runtime queries. lib/db.ts adds connection_limit / pool_timeout / connect_timeout
# (and pgbouncer=true for pooled hosts) unless you set them here.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/database?sslmode=require"
# DIRECT_URL: Neon *direct* connection string (no "-pooler"). Used by `prisma migrate`
# and other schema commands via `directUrl` in prisma/schema.prisma. Required for migrations.
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/database?sslmode=require"
# Optional per-instance pool tuning (defaults shown; see docs/DEVOPS.md)
# DB_CONNECTION_LIMIT=1
# DB_POOL_TIMEOUT=10
# DB_CONNECT_TIMEOUT=15

# Privy
NEXT_PUBLIC_PRIVY_APP_ID=your-privy-app-id
PRIVY_APP_SECRET=your-privy-app-secret
PRIVY_WEBHOOK_SECRET=whsec_your-privy-webhook-signing-secret

# Alchemy (Base)
ALCHEMY_API_KEY=your-alchemy-key
NEXT_PUBLIC_BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/your-alchemy-key

# MoonPay
NEXT_PUBLIC_MOONPAY_API_KEY=pk_test_xxxxx
MOONPAY_SECRET_KEY=sk_test_xxxxx
MOONPAY_WEBHOOK_KEY=wk_xxxxx
# Maximum age in seconds for Moonpay-Signature-V2 timestamps (default: 300)
MOONPAY_WEBHOOK_TOLERANCE_SECONDS=300

# Cloudinary (KYC uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ---------- Stellar (backend/server-only) ----------
STELLAR_NETWORK=testnet
# Canonical funding wallet secret. Used by wallet funding and, unless a
# dedicated sponsor key is set below, by USDC trustline bootstrap.
STELLAR_FUNDING_WALLET_SECRET=SXXXXXXXXXXXXXXXXXXXXXXXX
# Optional dedicated sponsor key for trustline bootstrap only.
# STELLAR_SPONSOR_SECRET=SXXXXXXXXXXXXXXXXXXXXXXXX
# Deprecated alias for STELLAR_FUNDING_WALLET_SECRET. Still accepted with a
# startup warning; the canonical name wins when both are set.
# STELLAR_FUNDING_SECRET=SXXXXXXXXXXXXXXXXXXXXXXXX
ADMIN_ALERT_EMAIL=admin@example.com

# Encryption key for secrets at rest (2FA seeds, wallet keys).
# REQUIRED in production — generate with: openssl rand -base64 32
# Must be at least 32 bytes of random entropy. Without it, production
# encrypt/decrypt calls throw; non-production uses an insecure dev fallback.
ENCRYPTION_KEY=change-me-32-bytes-of-random-entropy!!

# ---------- Resend ----------
RESEND_API_KEY=re_xxxxx
RESEND_FROM="LancePay <onboarding@resend.dev>"

# Paystack
PAYSTACK_SECRET_KEY=sk_test_xxxxx

# ---------- Stellar (frontend) ----------
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_USDC_ISSUER=GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN
NEXT_PUBLIC_USDC_CODE=USDC

# ---------- Custom Off-ramp ----------
OFFRAMP_API_KEY=your_offramp_api_key
OFFRAMP_API_SECRET=your_offramp_api_secret
OFFRAMP_API_URL=https://api.customofframp.com/v1
OFFRAMP_WEBHOOK_SECRET=your_offramp_webhook_secret

# ---------- Payment Advance ----------
TREASURY_WALLET_ADDRESS=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Platform delegated signer for withdrawal debits. Must be registered as an
# additional signer with sufficient weight on each user's Stellar wallet
# during provisioning so it can co-sign real on-chain withdrawal payments.
WITHDRAWAL_DELEGATE_SECRET_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

MAX_ADVANCE_PERCENTAGE=50
ADVANCE_FEE_PERCENTAGE=2
MAX_OUTSTANDING_ADVANCES=5000
MIN_COMPLETED_INVOICES=3
MIN_ACCOUNT_AGE_DAYS=7
MIN_TOTAL_EARNED=100

# ---------- Badge System ----------
BADGE_ISSUER_SECRET_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Bearer credential for trusted jobs calling /api/badges/award and /api/badges/[badgeId]/revoke
BADGE_SYSTEM_SECRET=replace-with-a-long-random-string

# ---------- External APIs ----------
COINGECKO_API_URL="https://api.coingecko.com/api/v3"
OPENAI_API_KEY=sk-proj-xxxxx

# ---------- KYC Rate Limiting ----------
# Comma-separated list of user IDs that bypass KYC rate limits (e.g., support/test accounts).
# SECURITY NOTE: In production (NODE_ENV=production), bypass IDs are refused and ignored
# unless ALLOW_KYC_RATE_LIMIT_BYPASS=true is explicitly set. Leaving bypass IDs enabled in
# production without authorization creates abuse risk. Every bypass usage logs a structured warning.
# KYC_RATE_LIMIT_BYPASS_IDS=test-user-1,test-user-2
# ALLOW_KYC_RATE_LIMIT_BYPASS=false
