# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon Database
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Privy
NEXT_PUBLIC_PRIVY_APP_ID=your-privy-app-id
PRIVY_APP_SECRET=your-privy-app-secret
PRIVY_WEBHOOK_SECRET=whsec_your-privy-webhook-signing-secret

# MoonPay
NEXT_PUBLIC_MOONPAY_API_KEY=pk_test_xxxxx
MOONPAY_SECRET_KEY=sk_test_xxxxx
MOONPAY_WEBHOOK_KEY=wk_xxxxx
# Maximum age in seconds for Moonpay-Signature-V2 timestamps (default: 300)
MOONPAY_WEBHOOK_TOLERANCE_SECONDS=300

# Cloudinary (KYC uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ---------- Stellar (backend/server-only) ----------
STELLAR_NETWORK=testnet
STELLAR_FUNDING_WALLET_SECRET=SXXXXXXXXXXXXXXXXXXXXXXXX
STELLAR_FUNDING_SECRET=SXXXXXXXXXXXXXXXXXXXXXXXX
STELLAR_SPONSOR_SECRET=SXXXXXXXXXXXXXXXXXXXXXXXX
ADMIN_ALERT_EMAIL=admin@example.com
# Comma-separated list of admin emails (used for admin checks and alerts)
ADMIN_EMAILS=admin@example.com

# ---------- Resend ----------
RESEND_API_KEY=re_xxxxx
RESEND_FROM="LancePay <onboarding@resend.dev>"
DEFAULT_SENDER_DOMAIN=example.com

# Paystack
PAYSTACK_SECRET_KEY=sk_test_xxxxx

# ---------- Stellar (frontend) ----------
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_USDC_ISSUER=GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN
NEXT_PUBLIC_USDC_CODE=USDC

# ---------- Custom Off-ramp ----------
OFFRAMP_API_KEY=your_offramp_api_key
OFFRAMP_API_SECRET=your_offramp_api_secret
OFFRAMP_API_URL=https://api.customofframp.com/v1
OFFRAMP_WEBHOOK_SECRET=your_offramp_webhook_secret

# ---------- Payment Advance ----------
TREASURY_WALLET_ADDRESS=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Platform delegated signer for withdrawal debits. Must be registered as an
# additional signer with sufficient weight on each user's Stellar wallet
# during provisioning so it can co-sign real on-chain withdrawal payments.
WITHDRAWAL_DELEGATE_SECRET_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

MAX_ADVANCE_PERCENTAGE=50
ADVANCE_FEE_PERCENTAGE=2
MAX_OUTSTANDING_ADVANCES=5000
MIN_COMPLETED_INVOICES=3
MIN_ACCOUNT_AGE_DAYS=7
MIN_TOTAL_EARNED=100

# ---------- Badge System ----------
BADGE_ISSUER_SECRET_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Bearer credential for trusted jobs calling /api/badges/award and /api/badges/[badgeId]/revoke
BADGE_SYSTEM_SECRET=replace-with-a-long-random-string

# ---------- External APIs ----------
COINGECKO_API_URL="https://api.coingecko.com/api/v3"
OPENAI_API_KEY=sk-proj-xxxxx
EXCHANGE_RATE_API_KEY=your-exchange-rate-api-key

# ---------- Security / Auth ----------
# Secret for HMAC-signing audit events (lib/audit.ts and audit-event writers)
AUDIT_SIGNING_SECRET=replace-with-a-long-random-string
# Secret for session/auth token verification
AUTH_SECRET=replace-with-a-long-random-string
# 32-byte key used to encrypt stored wallet secret keys (collective wallets)
ENCRYPTION_KEY=replace-with-a-32-byte-key!
# Salt for wallet address lookups
LOOKUP_SALT=replace-with-a-random-salt
# Bearer token protecting cron endpoints
CRON_SECRET=replace-with-a-long-random-string
# Shared secret for Circle webhook signature verification
CIRCLE_WEBHOOK_SECRET=replace-with-a-long-random-string

# ---------- MoneyGram / Yellow Card ----------
MONEYGRAM_CLIENT_ID=your-moneygram-client-id
MONEYGRAM_CLIENT_SECRET=your-moneygram-client-secret
MONEYGRAM_SEP24_ENDPOINT=https://api.moneygram.com/sep24
YELLOWCARD_CLIENT_ID=your-yellowcard-client-id
YELLOWCARD_CLIENT_SECRET=your-yellowcard-client-secret
YELLOWCARD_SEP24_ENDPOINT=https://api.yellowcard.io

# ---------- Anchor sessions ----------
ANCHOR_SESSION_EXPIRY_MINUTES=30

# ---------- Compliance / structuring monitoring ----------
STRUCTURING_WINDOW_DAYS=30
STRUCTURING_REPORTING_THRESHOLD_USD=10000
STRUCTURING_NEAR_THRESHOLD_RATIO=0.8
STRUCTURING_MIN_CLUSTER_SIZE=3
OCR_AUTO_APPROVAL_THRESHOLD=0.9
KYC_REVIEW_SLA_WINDOW_MS=86400000
WHITELIST_COOLDOWN_HOURS=24

# ---------- Reporting ----------
REPORT_PLATFORM_FEE_RATE=0.01
REPORT_WITHDRAWAL_FEE_RATE=0.005

# ---------- Misc ----------
LOG_LEVEL=info
GRAPHQL_SCHEMA_PATH=./schema.graphql

# ---------- KYC Rate Limiting ----------
KYC_RATE_LIMIT_BYPASS_IDS=id1,id2
